{
  "buildCommand": "npm --prefix Frontend install && npm --prefix Frontend run build",
  "outputDirectory": "Frontend/dist",
  "rewrites": [
    {
      "source": "/chat/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/speech/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/translate/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
