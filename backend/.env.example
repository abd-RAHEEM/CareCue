# Sarvam AI API Key for Voice and Translation (Required for Speech & Translate)
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Gemini API Key for AI Companion (Optional - falls back to ReMe engine if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional ReMe API Key
REME_API_KEY=your_reme_api_key_here
