# ==============================================================================
# CareCue .gitignore
# ==============================================================================

# --- Node / Frontend dependencies & build output ---
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Python / Backend environments & caches ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Environment variables & secrets ---
.env
.env.*
!.env.example
Frontend/.env.local
Frontend/.env.*.local
!Frontend/.env.example

# --- Local SQLite Databases & Audio caches ---
*.db
*.sqlite
*.sqlite3
backend/cognicare.db
cognicare.db
backend/generated_audio/
*.wav
*.mp3
*.ogg
*.m4a
*.flac
test_output.wav

# --- IDE & OS metadata ---
.DS_Store
Thumbs.db
.idea/
# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
